# -----------------------------------------------------------------------------
# Copie para .env.local e preencha. NUNCA versione o .env.local.
# -----------------------------------------------------------------------------

# Supabase → Project Settings → API (Data API) / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...) ou a chave "anon" legada
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...) ou "service_role" legada — SOMENTE servidor
SUPABASE_SECRET_KEY=

# URL pública da aplicação (usada em links de convite e redirecionamentos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave para criptografar credenciais fiscais (32 bytes em base64).
# Gere com: openssl rand -base64 32
FISCAL_ENCRYPTION_KEY=
